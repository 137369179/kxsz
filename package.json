{
  "name": "cathy-literacy",
  "version": "2.8.0",
  "type": "module",
  "scripts": {
    "build": "vite build && cp sw.js dist/sw.js && cp -r assets/images dist/assets/ && node tools/_gen_sw_manifest.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "node tools/_boot_smoke.mjs && node tools/_p4_smoke.mjs",
    "smoke:boot": "node tools/_boot_smoke.mjs",
    "smoke:engines": "node tools/_p4_smoke.mjs"
  },
  "devDependencies": {
    "vite": "^5.4.21",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "jsdom": "^30.0.1",
    "tough-cookie": "^6.0.2"
  }
}
